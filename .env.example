PORT=
MONGODB_URI=
JWT_SECRET=MuslimServerSecretKey
JWT_EXPIRES_IN=15m

# --- Video importer (Phase 1) ---
# The playlist importer reuses these same YouTube/AI settings.
# YouTube Data API v3 key (required). See README.md.
YOUTUBE_API_KEY=
# Comma-separated channel ids (start with UC). Leave empty to use the
# placeholders in src/video-imports/video-imports.config.ts.
YOUTUBE_IMPORT_CHANNEL_IDS=
# Recent uploads checked per channel, 1-50 (default 5).
YOUTUBE_IMPORT_MAX_VIDEOS_PER_CHANNEL=5
# Videos at or below this duration are treated as YouTube Shorts and skipped.
# Shorts are at most 3 minutes (180s). Set 0 to disable the filter.
YOUTUBE_IMPORT_SHORTS_MAX_DURATION_SECONDS=180
# --- AI metadata suggestions (optional, free by default) ---
# gemini (default) | groq | ollama | openai | custom
AI_PROVIDER=gemini
# Gemini free key: https://aistudio.google.com/apikey
# Groq free key:   https://console.groq.com/keys
# Ollama needs no key (local): AI_PROVIDER=ollama
# Leave AI_API_KEY empty to import minimal drafts from the source metadata.
AI_API_KEY=
# Only needed to override the selected provider preset:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-lite-latest
