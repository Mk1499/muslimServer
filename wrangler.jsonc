{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muslim-server",
  "main": "worker-dist/worker.js",
  "build": {
    "command": "./node_modules/.bin/tsc -p tsconfig.worker.json",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-11-27",
  "vars": {
    "CLOUDFLARE_WORKER": "true"
  },
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules",
    "nodejs_compat_populate_process_env",
    "enable_nodejs_http_modules"
  ],
  "alias": {
    "@nestjs/websockets/socket-module": "./stubs/empty.js",
    "@nestjs/microservices": "./stubs/empty.js",
    "@nestjs/microservices/microservices-module": "./stubs/empty.js",
    "class-transformer/storage": "./node_modules/class-transformer/cjs/storage.js"
  }
}
